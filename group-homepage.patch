+        </p>
+      </motion.section>
+
+      {/* Направления */}
+      <section className="max-w-6xl mx-auto px-6 pb-28">
+        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
+          {divisions.map((d) => {
+            const Icon = d.icon;
+            return (
+              <Link
+                key={d.key}
+                href={d.href}
+                className={`group relative flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-7 transition-colors ${d.accent.border}`}
+              >
+                <div className="flex items-start justify-between mb-6">
+                  <div className={`w-11 h-11 rounded-xl flex items-center justify-center ${d.accent.iconBg}`}>
+                    <Icon className={`w-5 h-5 ${d.accent.text}`} />
+                  </div>
+                  <ArrowUpRight className="w-4 h-4 text-gray-600 group-hover:text-gray-300 transition-colors" />
+                </div>
+
+                <h2 className="text-xl font-semibold mb-1">
+                  <span className="font-light text-gray-400">lukos</span> {d.name}
+                </h2>
+                <p className={`text-sm mb-4 ${d.accent.text}`}>{d.role}</p>
+                <p className="text-gray-400 text-sm leading-relaxed mb-6">{d.description}</p>
+
+                <ul className="mt-auto space-y-2 pt-4 border-t border-white/10">
+                  {d.facts.map((fact) => (
+                    <li key={fact} className="flex items-center gap-2 text-xs text-gray-500">
+                      <span className={`w-1 h-1 rounded-full ${d.accent.dot}`} />
+                      {fact}
+                    </li>
+                  ))}
+                </ul>
+              </Link>
+            );
+          })}
+        </div>
+      </section>
+
+      <Footer />
+    </div>
+  );
+}
