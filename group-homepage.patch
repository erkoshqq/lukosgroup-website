+          className="text-sm text-gray-400 hover:text-white transition-colors"
+        >
+          Связаться
+        </a>
+      </header>
+
+      {/* Hero */}
+      <motion.section
+        initial={{ opacity: 0, y: 16 }}
+        animate={{ opacity: 1, y: 0 }}
+        transition={{ duration: 0.7 }}
+        className="max-w-4xl mx-auto px-6 pt-12 pb-20 text-center"
